<Page x:Class="Messenger_Vasanov_ISP33.MainAppPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Messenger_Vasanov_ISP33"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="MainAppPage">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111111" BorderBrush="#222222" BorderThickness="0 0 2 0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Мессенджер" Style="{StaticResource Title}" FontSize="20" HorizontalAlignment="Center" Margin="0 10 0 30"/>

                <StackPanel Grid.Row="1">
                    <Button x:Name="ChatsTabBtn" Content="Чаты" Style="{StaticResource Button}" Click="ChatsTabBtn_Click" Height="40"/>
                    <Button x:Name="ProfileTabBtn" Content="Профиль" Style="{StaticResource DarkButton}" Click="ProfileTabBtn_Click" Height="40"/>
                </StackPanel>

                <Button Grid.Row="2" x:Name="LogoutBtn" Content="Выйти" Style="{StaticResource DarkButton}" BorderBrush="Crimson" Foreground="Crimson" Click="LogoutBtn_Click" Height="40"/>
            </Grid>
        </Border>

        <Frame Grid.Column="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
