<Page x:Class="Messenger_Vasanov_ISP33.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Messenger_Vasanov_ISP33"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Login">

    <Grid Background="Black">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="20">
            <TextBlock Text="Вход / Регистрация" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0 0 0 25"/>

            <StackPanel x:Name="AuthStepPanel" Visibility="Visible">
                <TextBlock Text="Номер телефона:" Style="{StaticResource TextInput}" Margin="0 5"/>
                <TextBox x:Name="LoginPhone" Style="{StaticResource Input}" Margin="0 0 0 15" Text="+7-" TextChanged="LoginPhone_TextChanged" MaxLength="16"/>

                <TextBlock Text="Капча:" Style="{StaticResource TextInput}" Margin="0 5"/>
                <Grid Margin="0 0 0 20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CaptchaContainer" Grid.Column="0" Style="{StaticResource CaptchaText}"/>
                    <TextBox x:Name="CaptchaInput" Grid.Column="1" Style="{StaticResource CaptchaInput}" Margin="10 0"/>
                    <Button x:Name="CaptchaRefresh" Grid.Column="2" Content="⟲" Style="{StaticResource CaptchaRefresh}" Click="CaptchaRefresh_Click"/>
                </Grid>

                <Button x:Name="SendSmsBtn" Content="Получить код СМС" Style="{StaticResource Button}" Click="SendSmsBtn_Click" Margin="0 10 0 0"/>
            </StackPanel>

            <StackPanel x:Name="SmsStepPanel" Visibility="Collapsed">
                <TextBlock Text="Введите 4-значный код из СМС:" Style="{StaticResource TextInput}" HorizontalAlignment="Center" Margin="0 5"/>
                <TextBox x:Name="SmsCodeInput" Style="{StaticResource Input}" FontSize="20" HorizontalContentAlignment="Center" MaxLength="4" Height="45" Margin="0 10 0 20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToAuthBtn" Grid.Column="0" Content="Назад" Style="{StaticResource DarkButton}" Margin="0 0 5 0" Click="BackToAuthBtn_Click"/>
                    <Button x:Name="VerifyBtn" Grid.Column="1" Content="Войти" Style="{StaticResource Button}" Click="VerifyBtn_Click"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
