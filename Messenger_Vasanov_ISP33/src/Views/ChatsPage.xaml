<Page x:Class="Messenger_Vasanov_ISP33.ChatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Messenger_Vasanov_ISP33"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChatsPage">

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111111" BorderBrush="#222222" BorderThickness="0 0 2 0">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Мои чаты" Foreground="White" FontWeight="Bold" FontSize="18" Margin="5 10"/>

                <Grid Grid.Row="1" Margin="0 0 0 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchPhoneInput" Grid.Column="0" Style="{StaticResource Input}" Height="35" FontSize="14" TextChanged="SearchPhoneInput_TextChanged"/>
                    <Button x:Name="AddChatBtn" Grid.Column="1" Style="{StaticResource Button}" Content="+" Width="35" Height="35" Margin="5 0 0 0" Click="AddChatBtn_Click" FontSize="12"/>
                </Grid>

                <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="4" Margin="0 0 0 5" Padding="5" Height="30">
                    <TextBlock x:Name="SearchMessage" Foreground="#FF6666" FontSize="13" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <ListBox Grid.Row="3" x:Name="ChatsListBox" Background="Transparent" BorderBrush="Transparent" SelectionChanged="ChatsListBox_SelectionChanged" Margin="0 5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" Width="274" Padding="10" Margin="0 2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Border Width="35" Height="35" CornerRadius="18" Background="Gold">
                                            <TextBlock Text="{Binding FirstLetter}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                        </Border>

                                        <Border Width="12" Height="12" CornerRadius="6" Background="#FF4444" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#111111" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding InterlocutorName}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="10 0 0 0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" x:Name="EmptyChatsPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Чатов пока нет" Foreground="#666" FontSize="16" Margin="0 10"/>
                    <TextBlock Text="Введите телефон и нажмите +" Foreground="#444" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#0A0A0A">
            <StackPanel x:Name="NoChatSelectedPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Выберите чат" Foreground="#666" FontSize="16" Margin="0 10"/>
            </StackPanel>

            <Grid x:Name="DialogPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0 0 0 1" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="Gold" Margin="0 0 10 0">
                                <TextBlock x:Name="DialogAvatar" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                            </Border>
                            <TextBlock x:Name="DialogName" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="BlockBtn" Grid.Column="1" 
                                Content="Заблокировать" 
                                Background="#FF4444" 
                                Foreground="White" 
                                FontWeight="Bold"
                                FontSize="12"
                                Padding="10 5"
                                BorderBrush="#FF4444"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BlockBtn_Click"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="MessagesListBox" Background="Transparent" BorderBrush="Transparent" Margin="10" 
                         ScrollViewer.CanContentScroll="False" 
                         ScrollViewer.PanningMode="VerticalOnly" 
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border x:Name="DateSeparatorBorder" Margin="0 10 0 10" Background="#1A1A1A" CornerRadius="10" Padding="15 5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDateSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayDate}" Foreground="#888888" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>

                                <Border x:Name="UnreadSeparatorBorder" Margin="0 10 0 10" Background="#1A1A1A" CornerRadius="10" Padding="20 5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnreadSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" Foreground="#FFD700" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                </Border>

                                <Border x:Name="MessageBorder" Margin="0 3" Padding="10 8" CornerRadius="8" MaxWidth="400">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDateSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUnreadSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="#2A5A2A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Text}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Text="{Binding DisplayTime}" Foreground="#888888" FontSize="10" HorizontalAlignment="Right" Margin="0 3 0 0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="BlockedOverlay" Grid.Row="1" Background="#0A0A0A" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="BlockedMessage" Text="Вы добавили пользователя в чёрный список" 
                                   Foreground="#FF4444" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#1A1A1A" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageInput" Grid.Column="0" Style="{StaticResource Input}" Height="40" FontSize="14" KeyDown="MessageInput_KeyDown"/>
                        <Button x:Name="SendBtn" Grid.Column="1" Style="{StaticResource Button}" Content="➤" Width="50" Height="40" Margin="10 0 0 0" FontSize="18" Click="SendBtn_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>